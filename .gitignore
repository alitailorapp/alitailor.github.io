# ── Archives & backups (NOT needed for the website) ─────────────────
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.gz
*.bak
*.old
*.tmp
*.temp

# ── Editor / temporary files ─────────────────────────────────────────
*~
*.swp
*.swo
*.log
.idea/
.vscode/
*.code-workspace

# ── OS junk files ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Raw design sources (large; only exported images go on the site) ──
*.psd
*.ai
*.fig
*.sketch

# ── Local tooling & secrets ──────────────────────────────────────────
node_modules/
.env
.env.*
__pycache__/
*.pyc

# ── SSH keys & credentials (never commit these) ─────────────────────
.ssh/
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ppk
*.pem
*.key
known_hosts
known_hosts.old
credentials.json
client_secret*.json
*.token

# NOTE: .png / .jpg / .webp screenshots are NOT ignored on purpose —
# they will be used in the Hero section and the "How to Use" guide.
